{
  "name": "blockchain",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "node": "npx hardhat node",
    "deploy:local": "npx hardhat ignition deploy ignition/modules/Credential.ts --network localhost",
    "check:student": "npx hardhat run scripts/checkStudent.ts --network localhost",
    "check:professor": "npx hardhat run scripts/checkProfessor.ts --network localhost",
    "check:academy": "npx hardhat run scripts/checkAcademy.ts --network localhost",
    "copy:abis": "cp artifacts/contracts/Credential.sol/Credential.json ../api/src/blockchain/contracts/S2dent.json"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.6",
    "@nomicfoundation/hardhat-ignition": "^3.0.9",
    "@nomicfoundation/hardhat-ignition-viem": "^3.0.9",
    "@nomicfoundation/hardhat-keystore": "^3.0.5",
    "@nomicfoundation/hardhat-mocha": "^3.0.13",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.4",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.3",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.3",
    "@nomicfoundation/hardhat-verify": "^3.0.12",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "chai": "^6.2.2",
    "hardhat": "^3.1.12",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.0",
    "viem": "^2.47.4"
  },
